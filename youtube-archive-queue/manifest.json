{
  "manifest_version": 3,
  "name": "YouTube Archive Queue",
  "version": "0.5.9",
  "description": "チャンネルに表示された動画を、その順番のまま連続再生します。",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://piniki-dev.github.io/youtube-archive-queue/*"
  ],
  "action": {
    "default_title": "Archive Queueを管理",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
